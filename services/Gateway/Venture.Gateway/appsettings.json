{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "follow": {
        "ClusterId": "social",
        "Order": 1,
        "Match": {
          "Path": "/users/{userId}/follow"
        }
      },
      "profiles": {
        "ClusterId": "users",
        "Order": 1,
        "Match": {
          "Path": "/assets/profiles/{**catch-all}"
        }
      },
      "users-root": {
        "ClusterId": "users",
        "Order": 2,
        "Match": {
          "Path": "/users"
        }
      },
      "users": {
        "ClusterId": "users",
        "Order": 2,
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "posts-root": {
        "ClusterId": "posts",
        "Order": 2,
        "Match": {
          "Path": "/posts"
        }
      },
      "posts": {
        "ClusterId": "posts",
        "Order": 2,
        "Match": {
          "Path": "/posts/{**catch-all}"
        }
      },
      "feed-root": {
        "ClusterId": "posts",
        "Order": 2,
        "Match": {
          "Path": "/feed"
        }
      },
      "feed": {
        "ClusterId": "posts",
        "Order": 2,
        "Match": {
          "Path": "/feed/{**catch-all}"
        }
      },
      "achievement-groups": {
        "ClusterId": "achievements",
        "Order": 1,
        "Match": {
          "Path": "/internal/users/{userId}/achievement-groups"
        }
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5231/"
          }
        }
      },
      "posts": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5232/"
          }
        }
      },
      "social": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5233/"
          }
        }
      },
      "achievements": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5234/"
          }
        }
      }
    }
  }
}
